{
  "name": "cashier-de-yudira-desktop",
  "version": "2.0.5",
  "private": true,
  "description": "Versión ejecutable de escritorio de Cashier de Yudira V2.0.5",
  "main": "main.js",
  "scripts": {
    "start": "npm run sync:www && electron .",
    "sync:www": "node scripts/sync-www.js",
    "build": "npm run sync:www && electron-builder --win --x64",
    "build:portable": "npm run sync:www && electron-builder --win portable --x64",
    "build:installer": "npm run sync:www && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.kakycu.cashierdeyudira.desktop",
    "productName": "Cashier de Yudira",
    "artifactName": "CashierDeYudira-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "www/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cashier de Yudira"
    },
    "portable": {
      "artifactName": "CashierDeYudira-${version}-portable-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
